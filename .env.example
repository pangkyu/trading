# Copy to  ~/.nhplug/.env  (전역, 권장)  또는 프로젝트 루트의  .env  로 두고 값을 채운다.
# .env 는 .gitignore 에 있음. 절대 커밋하지 말 것.

NHPLUG_APP_KEY=발급받은_APP_KEY
NHPLUG_APP_SECRET=발급받은_APP_SECRET

# === 모의투자 (개발·검증) ===
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443
NHPLUG_AUTH_URL=https://api.nhplug.com:8443     # 토큰은 운영에서만 발급 (moapi 미제공)

# === 실거래 (라이브) — 위 BASE_URL 을 아래로 교체 ===
# NHPLUG_BASE_URL=https://api.nhplug.com:8443
# NHPLUG_AUTH_URL=https://api.nhplug.com:8443

# N2 브랜드 고객은 위 세 URL 을 모두 n2plug.com 으로 바꾼다.

NHPLUG_INSTRUMENTS_BASE=https://www.nhplug.com/instruments
